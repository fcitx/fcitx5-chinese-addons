#: im/pinyin/pinyin.h:308
msgid ""
"N-th key in the option will select the N-th character in the current "
"candidate."
msgstr ""
"Den N:e tangenten i alternativet väljer det N:e tecknet i den aktuella "
"kandidaten."

#: im/pinyin/pinyin.h:312
msgid "Choose Last Character from Phrase"
msgstr "Välj sista tecknet från frasen"

